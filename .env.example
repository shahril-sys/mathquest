# Salin ke .env dan laraskan. (Aplikasi membaca pembolehubah persekitaran; fail .env dimuat jika wujud.)
PORT=3000
HOST=0.0.0.0
# Lokasi pangkalan data SQLite dan muat naik imej
DATA_DIR=./data
# Tetapkan true apabila di belakang HTTPS (cookie Secure + HSTS)
SECURE_COOKIES=false
# Bilangan proksi terbalik di hadapan aplikasi (Caddy/Nginx = 1). Biarkan 0 jika aplikasi didedahkan terus.
# Jika salah tetapkan, had kadar akan menyekat semua pengguna sekaligus atau boleh dipintas.
TRUST_PROXY=0
# Tempoh sesi log masuk (jam)
SESSION_HOURS=12
# Kata laluan awal untuk data demo (HANYA untuk demo; tukar dalam produksi)
DEMO_PASSWORD=MathQuest#2026
