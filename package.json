{
  "name": "mathquest-adventure",
  "version": "1.0.0",
  "description": "MathQuest Adventure – Misi Matematik & Ganjaran (permainan matematik sekolah rendah)",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.js",
    "purge": "node --disable-warning=ExperimentalWarning scripts/purge.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.js"
  }
}
